{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" cannot relay UDP (it is an HTTP proxy, or \"Supports UDP\" is off), so UDP will be blocked.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不支持 UDP 转发（它是 HTTP 代理，或没有勾选「服务器支持 UDP 转发」），UDP 会被阻断。"
          }
        }
      }
    },
    "\"Bound connections go direct\" is off and the default action is a proxy, so the proxy core behind %@ may be taken over and loop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭「绑定到网卡的连接直连」且默认动作为代理，%@ 背后的代理内核可能被接管，形成回环。"
          }
        }
      }
    },
    "%@ (code %lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (code %2$lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（代码 %lld）"
          }
        }
      }
    },
    "%@ is in fake-IP mode. Turn on \"Send hostnames to the proxy for resolution\" in Settings; otherwise remote proxies receive unusable addresses like 198.18.x.x.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 处于 fake-IP 模式，建议在设置中开启「优先把域名交给代理解析」，否则远程代理收到的是 198.18.x.x 这类无效地址。"
          }
        }
      }
    },
    "%@ · used by %lld rules": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · used by %#@rules@"
          },
          "substitutions": {
            "rules": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg rule"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg rules"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 条规则在使用"
          }
        }
      }
    },
    "%@%@ is carrying public traffic: a VPN or TUN tool": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@ is carrying public traffic: a VPN or TUN tool"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ 正在接管公网流量：VPN 或 TUN 工具"
          }
        }
      }
    },
    "%@%@ is carrying public traffic: a fake-IP TUN, probably Clash, FlClash or Surge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@ is carrying public traffic: a fake-IP TUN, probably Clash, FlClash or Surge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ 正在接管公网流量：fake-IP 模式的 TUN，可能是 Clash、FlClash 或 Surge"
          }
        }
      }
    },
    "%lld more…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 条…"
          }
        }
      }
    },
    "%lld rules use a proxy server that no longer exists.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld rule uses a proxy server that no longer exists."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld rules use a proxy server that no longer exists."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 条规则引用的代理服务器已不存在。"
          }
        }
      }
    },
    "%lld rules use this server. After it is deleted, they will switch to Direct.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld rule uses this server. After it is deleted, it will switch to Direct."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld rules use this server. After it is deleted, they will switch to Direct."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 条规则正在使用它，删除后这些规则会改为「直连」。"
          }
        }
      }
    },
    "%lld s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒"
          }
        }
      }
    },
    "%llu connections · latest: %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@connections@ · latest: %2$@ · %3$@"
          },
          "substitutions": {
            "connections": {
              "argNum": 1,
              "formatSpecifier": "llu",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg connection"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg connections"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%llu 个连接 · 最近：%@ · %@"
          }
        }
      }
    },
    "%llu direct": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直连 %llu"
          }
        }
      }
    },
    "%llu failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%llu 次失败"
          }
        }
      }
    },
    ", ": {
      "comment": "Separator between app names",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        }
      }
    },
    "Action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作"
          }
        }
      }
    },
    "Active": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动"
          }
        }
      }
    },
    "Active Rules": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生效中的规则"
          }
        }
      }
    },
    "Active connections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动连接"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 %lld 个"
          }
        }
      }
    },
    "Add Rule": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加规则"
          }
        }
      }
    },
    "Add a proxy server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加代理服务器"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "Also matches helper processes whose identifier starts with \"%@.\", and every process inside this app bundle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时匹配以「%@.」开头的 helper 进程，以及位于该应用包内的所有进程。"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "App Rules": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用规则"
          }
        }
      }
    },
    "App or destination": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用或目标"
          }
        }
      }
    },
    "Apple-signed processes in /System, /usr and similar folders (system services, command-line tools) skip the default action unless a rule matches them explicitly. Turning this off may affect software updates, iCloud and more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 签名且位于 /System、/usr 等目录的进程（系统服务、命令行工具）不走默认动作，除非被规则显式命中。关闭后可能影响系统更新、iCloud 等。"
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Apps without a rule": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命中规则的应用"
          }
        }
      }
    },
    "Apps without a rule: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命中规则的应用：%@"
          }
        }
      }
    },
    "Authentication (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证（可选）"
          }
        }
      }
    },
    "Authorization is required. Allow it in System Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要授权，请在系统设置中允许。"
          }
        }
      }
    },
    "Block": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻断"
          }
        }
      }
    },
    "Bound connections go direct (recommended)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定到网卡的连接直连（推荐）"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cannot read or write the system configuration. Did you deny the request to add a proxy configuration?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读写系统配置（是否拒绝了「添加代理配置」的请求？）"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        }
      }
    },
    "Choose Apps to Proxy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要代理的应用"
          }
        }
      }
    },
    "Choose Running Apps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择正在运行的应用"
          }
        }
      }
    },
    "Choose a Command-Line Tool or Executable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择命令行工具或可执行文件"
          }
        }
      }
    },
    "Choose a Command-Line Tool or Executable…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择命令行工具 / 可执行文件…"
          }
        }
      }
    },
    "Choose from Applications…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从「应用程序」中选择…"
          }
        }
      }
    },
    "Choose from Running Apps…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从正在运行的应用中选择…"
          }
        }
      }
    },
    "Choose the apps to proxy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要走代理的应用"
          }
        }
      }
    },
    "Choosing a proxy turns on exclusion mode: every app goes through the proxy except those set to Direct.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择「代理」即为排除模式：除了设为「直连」的应用外，所有应用都走代理。"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空"
          }
        }
      }
    },
    "Click Add in the toolbar and choose the apps or command-line tools to proxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击右上角的「添加」，选择要走代理的应用或命令行工具。"
          }
        }
      }
    },
    "Click Add in the toolbar to set up a SOCKS5 or HTTP proxy.\nLocal clients such as Clash or v2ray usually listen on a port like 127.0.0.1:7890.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击右上角的「添加」配置 SOCKS5 或 HTTP 代理。\n本机运行的 Clash、v2ray 等客户端一般提供 127.0.0.1:7890 之类的端口。"
          }
        }
      }
    },
    "Coexisting with Other VPN / TUN": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与其他 VPN / TUN 共存"
          }
        }
      }
    },
    "Configuration File": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件"
          }
        }
      }
    },
    "Connect to local network addresses directly": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网地址直连"
          }
        }
      }
    },
    "Connection timeout": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接超时"
          }
        }
      }
    },
    "Connections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        }
      }
    },
    "DNS resolver IP": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 服务器 IP"
          }
        }
      }
    },
    "Default Action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认动作"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Delete \"%@\"?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除「%@」？"
          }
        }
      }
    },
    "Destination": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标"
          }
        }
      }
    },
    "Detected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测结果"
          }
        }
      }
    },
    "Detected: %@. ProxyAppX's connections to remote proxies (%@) also pass through it and may be proxied twice. Turn on \"Upstream connections bypass other VPN / TUN\" under Settings › Coexisting with Other VPN / TUN, or add %@ to your Clash rules.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Detected: %1$@. ProxyAppX's connections to remote proxies (%2$@) also pass through it and may be proxied twice. Turn on \"Upstream connections bypass other VPN / TUN\" under Settings › Coexisting with Other VPN / TUN, or add %3$@ to your Clash rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到 %@。ProxyAppX 连接远程代理（%@）的流量会再经过它，可能被它二次代理。可在「设置 › 与其他 VPN / TUN 共存」中开启「上游连接绕过其他 VPN / TUN」，或在 Clash 规则中加入 %@。"
          }
        }
      }
    },
    "Direct": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直连"
          }
        }
      }
    },
    "Direct (recommended)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直连（推荐）"
          }
        }
      }
    },
    "Disable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停用"
          }
        }
      }
    },
    "Disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用"
          }
        }
      }
    },
    "Download": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "Duration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长"
          }
        }
      }
    },
    "Edit…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑…"
          }
        }
      }
    },
    "Enable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用"
          }
        }
      }
    },
    "Enable this rule": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用此规则"
          }
        }
      }
    },
    "Enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用"
          }
        }
      }
    },
    "Enabled (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用（%@）"
          }
        }
      }
    },
    "Ended": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束"
          }
        }
      }
    },
    "Enter an IPv4 or IPv6 address.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 IPv4 或 IPv6 地址。"
          }
        }
      }
    },
    "Error: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误：%@"
          }
        }
      }
    },
    "Errors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误"
          }
        }
      }
    },
    "Events from the network extension show up here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络扩展的事件会显示在这里。"
          }
        }
      }
    },
    "Every process that recently used the network matched a rule.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近联网的进程都已命中规则。"
          }
        }
      }
    },
    "Export failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出失败：%@"
          }
        }
      }
    },
    "Exported files do not include passwords. Importing replaces all current servers and rules.": {
      "localizations": {
