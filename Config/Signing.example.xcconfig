// 复制为 Config/Signing.xcconfig 并填入你自己的信息（该文件已在 .gitignore 中）。

// 你的 Apple Developer Team ID（钥匙串中证书名称括号里的 10 位字符）
DEVELOPMENT_TEAM = XXXXXXXXXX

// 如果 com.proxyappx 已被别人注册，改成你自己的反向域名
BUNDLE_ID_PREFIX = com.proxyappx

// —— 方案 A：开发调试（推荐）——
// Xcode 登录 Apple ID 后自动生成描述文件；App 需放到 /Applications 下运行。
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
NE_PROVIDER_ENTITLEMENT = app-proxy-provider

// —— 方案 B：Developer ID 手动签名（直接分发给他人）——
// 需要先在 developer.apple.com 创建两个 App ID（勾选 Network Extensions / System Extension）
// 和对应的 Developer ID 描述文件，然后取消下面的注释：
// CODE_SIGN_STYLE = Manual
// CODE_SIGN_IDENTITY = Developer ID Application
// NE_PROVIDER_ENTITLEMENT = app-proxy-provider-systemextension
// APP_PROVISIONING_PROFILE_SPECIFIER = ProxyAppX App Developer ID
// EXT_PROVISIONING_PROFILE_SPECIFIER = ProxyAppX Extension Developer ID

// —— 公证 DMG（make release / make dmg 用）——
// 先保存一次 notarytool 凭据（使用 Apple ID 的 App 专用密码，或 App Store Connect API 密钥）：
//   xcrun notarytool store-credentials proxyappx-notary --team-id XXXXXXXXXX
// 再在这里填写配置名。不填写时，DMG 不签名也不公证（里面的 App 仍会公证）。
// NOTARY_PROFILE = proxyappx-notary
